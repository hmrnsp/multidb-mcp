# Copy to .env and adjust:  cp .env.example .env
# The .env file holds credentials and MUST NOT be committed (it is already in .gitignore).
#
# The local ports deliberately do NOT use the default ports (5432/3306/50000) so they do not clash
# with databases already installed on your machine. Everything is bound to 127.0.0.1 only.

# --- Passwords used by databases.dev.json (the MCP server reads these) ----------------------
# databases.dev.json spells host, port, database, and user out; only the passwords live here.
# These match the containers in docker-compose.yml and are for LOCAL development only.
PG_LOCAL_PASSWORD=dev
MYSQL_LOCAL_PASSWORD=dev
MARIADB_LOCAL_PASSWORD=dev
REDIS_LOCAL_PASSWORD=dev
DB2_LOCAL_PASSWORD=db2dev-Passw0rd

# --- Full connection strings used ONLY by the integration tests and seed scripts ----------
# The MCP server itself does not read the *_URL / *_CONN variables below.

# --- PostgreSQL 17 (docker compose) ---------------------------------------------
PG_LOCAL_URL=postgres://dev:dev@127.0.0.1:55432/app
# A SELECT-only user (created by the seed) to test the minimal-privilege model
PG_LOCAL_RO_URL=postgres://mcp_ro:mcp_ro@127.0.0.1:55432/app

# --- MySQL 8.4 (docker compose) -------------------------------------------------
MYSQL_LOCAL_URL=mysql://dev:dev@127.0.0.1:53306/app
MYSQL_LOCAL_RO_URL=mysql://mcp_ro:mcp_ro@127.0.0.1:53306/app

# --- MariaDB 11.4 (docker compose) ----------------------------------------------
MARIADB_LOCAL_URL=mysql://dev:dev@127.0.0.1:53307/app
MARIADB_LOCAL_RO_URL=mysql://mcp_ro:mcp_ro@127.0.0.1:53307/app

# --- Redis 7.4 (docker compose) -------------------------------------------------
REDIS_LOCAL_URL=redis://default:dev@127.0.0.1:56379/0
# A read-only user (ACL +@read) to test the minimal-privilege model
REDIS_LOCAL_RO_URL=redis://mcp_ro:mcp_ro@127.0.0.1:56379/0

# --- Db2 Community Edition (docker compose, profile db2) -------------------------
# Format connection string ibm_db: KEY=VALUE;KEY=VALUE;
DB2_LOCAL_CONN=DATABASE=APPDB;HOSTNAME=127.0.0.1;PORT=55000;PROTOCOL=TCPIP;UID=db2inst1;PWD=db2dev-Passw0rd;

# --- Shared development Db2 (OPTIONAL, read-only check) ---------------------------
# Use a user that only has the SELECT privilege. NEVER fill this with a production connection.
# The "dev" check never writes data and never runs the heavy timeout test.
DB2_DEV_CONN=
# Schema to inspect (empty = the CURRENT SCHEMA of the user above)
DB2_DEV_SCHEMA=
