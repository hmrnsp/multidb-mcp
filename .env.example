# Copy to .env and adjust:  cp .env.example .env
# The .env file holds credentials and MUST NOT be committed (it is already in .gitignore).
#
# Only passwords live here. Hosts, ports, databases, and users are spelled out in databases.dev.json
# (for the MCP server) and in scripts/lib/dev-connections.mjs (for the tests and scripts); both match
# docker-compose.yml. The local ports deliberately do NOT use the default ports (5432/3306/50000) so
# they do not clash with databases already on your machine, and everything is bound to 127.0.0.1 only.

# --- Local development containers (docker compose) --------------------------------------------
# These match the containers in docker-compose.yml and are for LOCAL development only.
# The *_RO_PASSWORD variables are for the read-only users (created by the seeds and the Redis ACL)
# that the integration tests use to check the minimal-privilege model.
PG_LOCAL_PASSWORD=dev
PG_LOCAL_RO_PASSWORD=mcp_ro
MYSQL_LOCAL_PASSWORD=dev
MYSQL_LOCAL_RO_PASSWORD=mcp_ro
MARIADB_LOCAL_PASSWORD=dev
MARIADB_LOCAL_RO_PASSWORD=mcp_ro
REDIS_LOCAL_PASSWORD=dev
REDIS_LOCAL_RO_PASSWORD=mcp_ro
DB2_LOCAL_PASSWORD=db2dev-Passw0rd

# --- A shared development Db2 (OPTIONAL, read-only check: npm run check:db2:dev) ---------------
# Use a user that only has the SELECT privilege. NEVER fill this with a production database.
# The check never writes data and never runs the heavy timeout test. Leave it empty to skip it.
DB2_DEV_HOST=
DB2_DEV_PORT=50000
DB2_DEV_DATABASE=
DB2_DEV_USER=
DB2_DEV_PASSWORD=
# Schema to inspect (empty = the CURRENT SCHEMA of the user above)
DB2_DEV_SCHEMA=
