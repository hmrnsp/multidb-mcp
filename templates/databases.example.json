{
  "defaults": {
    "maxRows": 200,
    "timeoutSec": 30,
    "maxChars": 40000
  },
  "maskColumns": ["salary", "account_no"],
  "databases": [
    {
      "id": "local_mysql",
      "driver": "mysql",
      "env": "local",
      "access": ["read", "insert", "update", "delete", "ddl"],
      "description": "Laravel application database for development",
      "host": "127.0.0.1",
      "port": 3306,
      "database": "app",
      "user": "dev",
      "password": "${LOCAL_MYSQL_PASSWORD}"
    },
    {
      "id": "staging_pg",
      "driver": "postgres",
      "env": "staging",
      "access": ["read"],
      "description": "PostgreSQL staging for testing features before a release",
      "host": "pg.staging.example.internal",
      "port": 5432,
      "database": "app",
      "user": "app_staging",
      "password": "${STAGING_PG_PASSWORD}",
      "schemas": ["public"]
    },
    {
      "id": "prod_pg",
      "driver": "postgres",
      "env": "production",
      "access": ["read", "update"],
      "description": "PostgreSQL production; may fix data (UPDATE), may not add or delete rows",
      "host": "pg.example.internal",
      "port": 5432,
      "database": "app",
      "user": "mcp_app",
      "password": "${PROD_PG_PASSWORD}",
      "schemas": ["public"]
    },
    {
      "id": "prod_db2",
      "driver": "db2",
      "env": "production",
      "access": ["read"],
      "description": "Core transaction data, for reports only",
      "host": "db2.example.internal",
      "port": 50000,
      "database": "APPDB",
      "user": "mcp_ro",
      "password": "${PROD_DB2_PASSWORD}",
      "maxRows": 500,
      "schemas": ["CORE", "REPORT"]
    },
    {
      "id": "prod_redis",
      "driver": "redis",
      "env": "production",
      "access": ["read", "delete"],
      "description": "Redis production (Laravel cache & sessions); may delete broken cache entries",
      "host": "redis.example.internal",
      "user": "mcp_ops",
      "password": "${PROD_REDIS_PASSWORD}",
      "database": 0
    }
  ]
}
