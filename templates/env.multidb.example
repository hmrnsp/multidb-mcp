# Credentials for the connections in databases.json (see templates/databases.example.json).
#
# Copy this file to `.env.multidb` in your application project, fill in the real passwords, and
# restrict it:   chmod 600 .env.multidb
#
# NEVER commit it. Add `.env.multidb` to the project's .gitignore before you create it.
# Only passwords go here; host, port, database, and user are written in databases.json.
# A password may contain any character (@ : / # ...): it is URL-encoded for you.
# The values below are placeholders. The server refuses to start when a variable is missing or empty.

# local_mysql: the MySQL used for development
LOCAL_MYSQL_PASSWORD=change-me

# staging_pg: PostgreSQL staging
STAGING_PG_PASSWORD=change-me

# prod_pg: PostgreSQL production
PROD_PG_PASSWORD=change-me

# prod_db2: Db2 production (the user should only have SELECT)
PROD_DB2_PASSWORD=change-me

# prod_redis: Redis production (an ACL user with the least privileges)
PROD_REDIS_PASSWORD=change-me
