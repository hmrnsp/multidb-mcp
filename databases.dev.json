{
  "defaults": {
    "maxRows": 200,
    "timeoutSec": 30,
    "maxChars": 40000
  },
  "databases": [
    {
      "id": "local_pg",
      "driver": "postgres",
      "env": "local",
      "access": ["read", "insert", "update", "delete", "ddl", "call"],
      "description": "PostgreSQL 17 in Docker for developing multidb-mcp (sample data app.customers & app.orders)",
      "host": "127.0.0.1",
      "port": 55432,
      "database": "app",
      "user": "dev",
      "password": "${PG_LOCAL_PASSWORD}",
      "schemas": ["app"]
    },
    {
      "id": "local_mysql",
      "driver": "mysql",
      "env": "local",
      "access": ["read", "insert", "update", "delete", "ddl", "call"],
      "description": "MySQL 8.4 in Docker for developing multidb-mcp (sample data customers & orders)",
      "host": "127.0.0.1",
      "port": 53306,
      "database": "app",
      "user": "dev",
      "password": "${MYSQL_LOCAL_PASSWORD}"
    },
    {
      "id": "local_mariadb",
      "driver": "mariadb",
      "env": "local",
      "access": ["read", "insert", "update", "delete", "ddl", "call"],
      "description": "MariaDB 11.4 in Docker for developing multidb-mcp (sample data customers & orders)",
      "host": "127.0.0.1",
      "port": 53307,
      "database": "app",
      "user": "dev",
      "password": "${MARIADB_LOCAL_PASSWORD}"
    },
    {
      "id": "local_db2",
      "driver": "db2",
      "env": "local",
      "access": ["read", "insert", "update", "delete", "ddl", "call"],
      "description": "Db2 Community Edition in Docker for developing multidb-mcp (schema APP)",
      "host": "127.0.0.1",
      "port": 55000,
      "database": "APPDB",
      "user": "db2inst1",
      "password": "${DB2_LOCAL_PASSWORD}",
      "schemas": ["APP"]
    },
    {
      "id": "local_sqlite",
      "driver": "sqlite",
      "env": "local",
      "access": ["read", "insert", "update", "delete", "ddl"],
      "description": "Local SQLite file for developing multidb-mcp (sample data customers & orders, npm run seed:sqlite)",
      "file": "./.data/app.sqlite"
    },
    {
      "id": "local_redis",
      "driver": "redis",
      "env": "local",
      "access": ["read", "insert", "update", "delete"],
      "description": "Redis 7.4 in Docker for developing multidb-mcp (sample cache, sessions, queues; npm run seed:redis)",
      "host": "127.0.0.1",
      "port": 56379,
      "user": "default",
      "password": "${REDIS_LOCAL_PASSWORD}",
      "database": 0
    }
  ]
}
